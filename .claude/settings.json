{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(bd)",
      "Bash(bd *)",
      "Bash(fort/scripts/emit.sh *)",
      "Bash(fort/scripts/status.sh*)",
      "Bash(/home/justin/dev/longburn/fort/scripts/emit.sh *)",
      "Bash(/home/justin/dev/longburn/fort/scripts/status.sh*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git worktree list*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git check-ignore*)",
      "Bash(git ls-files*)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * show*)",
      "Bash(git -C * branch*)",
      "Bash(git -C * worktree list*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * rev-list*)",
      "Bash(git -C * check-ignore*)",
      "Bash(git -C * ls-files*)",
      "Bash(git push origin main)",
      "Bash(git push -q origin main)",
      "Bash(git -C * push origin main)",
      "Bash(git add fort/*)",
      "Bash(git -C * add fort/*)",
      "Bash(git add docs/*)",
      "Bash(git -C * add docs/*)",
      "Bash(git add README.md)",
      "Bash(git add .beads/*)",
      "Bash(git commit -m *)",
      "Bash(git -C * commit -m *)",
      "Bash(npm run build*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest run*)",
      "Bash(node --test*)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(jq *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Edit(fort/events/*)",
      "Write(fort/events/*.jsonl)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep * .env*)",
      "Bash(git push --force*)",
      "Bash(git add .)",
      "Bash(git add -A*)",
      "Bash(git add --all*)"
    ]
  }
}
